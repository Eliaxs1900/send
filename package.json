{
  "name": "send",
  "description": "Encrypted file sharing, self-hosted",
  "version": "3.1.0",
  "author": "Mozilla (https://mozilla.org)",
  "repository": "mozilla/send",
  "homepage": "https://github.com/mozilla/send/",
  "license": "MPL-2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && webpack --mode=production",
    "lint": "npm-run-all lint:*",
    "lint:css": "stylelint \"app/**/*.css\"",
    "lint:js": "eslint .",
    "format": "prettier '**/*.js' 'assets/*.css' --write",
    "test": "npm run test:backend",
    "test:backend": "mocha --reporter=min test/backend",
    "start": "npm run clean && cross-env NODE_ENV=development L10N_DEV=true BASE_URL=http://localhost:1337 webpack serve --port=1337 --mode=development",
    "prod": "node server/bin/prod.js"
  },
  "dependencies": {
