extends: stylelint-config-standard

rules:
  # Tailwind aporta sus propias at-rules (@apply, @utility, @variant,
  # @config, @theme), que stylelint no conoce.
  at-rule-no-unknown: null
  # y las funciones theme()/screen() dentro de valores
  function-no-unknown: null
  # Tailwind 4 solo resuelve sus imports virtuales en forma de cadena:
  # convertirlos a url() deja fuera las utilidades del bundle
  import-notation: null
  # el proyecto usa prefijos -webkit-/-moz- a proposito para los gradientes
  # de <progress>, que no tienen equivalente estandar
  property-no-vendor-prefix: null
  value-no-vendor-prefix: null
  at-rule-no-vendor-prefix: null
  # nombres heredados con guiones y mayusculas mezcladas
  keyframes-name-pattern: null
  selector-class-pattern: null
  custom-property-pattern: null
